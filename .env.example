# Copy to .env and fill in. .env is git-ignored.

POSTGRES_DB=NotificationSystem
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# base64, at least 256 bit:  openssl rand -base64 48
JWT_SECRET=

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=event001_bot

# First administrator, created on startup if it does not exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Only needed with: docker compose --profile tools up
PGADMIN_PASSWORD=change-me

# Owner of the ghcr.io images used by `docker compose pull` on the server
REGISTRY_OWNER=oyehiazarian
